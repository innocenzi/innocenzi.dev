---
import { me } from '../data/me';
import { t } from '../i18n';

const links = [
	...me.socials.map(({ network, url }) => ({ href: url, text: network.toLowerCase() })),
	{ href: `mailto:${me.email}`, text: t.elsewhere.email },
	{ href: '/blog/rss.xml', text: t.elsewhere.feed },
];
---

<footer class="print:hidden">
	<nav aria-label={t.elsewhere.label}>
		<ul class="flex flex-wrap justify-center gap-x-5 gap-y-2 font-mono text-xs text-faint">
			{links.map(({ href, text }) => <li><a href={href} class="transition-colors hover:text-ink">{text}</a></li>)}
		</ul>
	</nav>
</footer>
